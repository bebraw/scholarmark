{
  "name": "scholarmark",
  "version": "0.10.2",
  "description": "A scientific Markdown specification and reference renderer",
  "license": "MIT",
  "author": "Juho Vepsäläinen",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "sideEffects": [
    "./dist/citation-js.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./citation-js": {
      "types": "./dist/citation-js.d.ts",
      "import": "./dist/citation-js.js",
      "default": "./dist/citation-js.js"
    }
  },
  "files": [
    "dist",
    "SPECIFICATION.md",
    "SYNTAX.md",
    "NATIVE_FIGURES.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bebraw/scholarmark.git"
  },
  "scripts": {
    "build": "npm run build:library && npm run build:vscode",
    "build:library": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build:library",
    "build:vscode": "node editors/vscode/esbuild.mjs",
    "package:vscode": "npm run build:vscode && npm --prefix editors/vscode run package",
    "test": "vitest run && npm run test:browser",
    "test:browser": "npm run build:library && node scripts/smoke-browser.mjs",
    "test:lsp": "npm run build:vscode && node scripts/smoke-language-server.mjs",
    "typecheck": "npm run typecheck:library && npm run typecheck:vscode",
    "typecheck:library": "tsc -p tsconfig.json --noEmit",
    "typecheck:vscode": "tsc -p editors/vscode/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@types/node": "20.19.43",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vscode-languageclient": "10.1.0",
    "vscode-languageserver": "10.1.0",
    "vscode-languageserver-textdocument": "1.0.13",
    "vscode-jsonrpc": "9.0.1",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2"
  },
  "peerDependenciesMeta": {
    "@citation-js/core": {
      "optional": true
    },
    "@citation-js/plugin-bibtex": {
      "optional": true
    }
  }
}
